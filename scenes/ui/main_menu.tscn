[node name="GuideText" type="RichTextLabel" parent="GuideModal/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "[color=#00e5ff][b]THE 30-SECOND TIME LOOP:[/b][/color]
You are trapped inside Chronos Sub-Level 4. Every 30 seconds, spacetime collapses and resets to the starting point.

[color=#00e5ff][b]TEMPORAL ECHOES:[/b][/color]
When a loop resets, an [color=#a0e0ff]Echo[/color] of your past self repeats your exact previous actions.
• Stand on a pressure plate in Loop 1.
• When the loop resets, your Echo holds the plate while you move freely!
• Coordinate past and present actions to unlock heavy blast doors and bypass laser grids.

[color=#00e5ff][b]CONTROLS:[/b][/color]
• [color=#ffdd55][WASD / Arrow Keys][/color] - Move Researcher
• [color=#ffdd55][E / Space][/color] - Interact with Terminals & Levers
• [color=#ffdd55][R][/color] - Rewind Loop immediately & spawn new Echo
• [color=#ffdd55][C / Backspace][/color] - Clear all Echoes & restart Chamber
• [color=#ffdd55][ESC][/color] - Pause Menu / Dismiss Log"

