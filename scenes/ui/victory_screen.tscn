[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/victory_screen.gd" id="1_win"]

[node name="VictoryScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_win")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.08, 0.14, 1)

[node name="Panel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(600, 440)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -220.0
offset_right = 300.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 1, 0.6, 1)
theme_override_font_sizes/font_size = 32
text = "CAUSALITY RESTORED"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.8, 1, 0.9)
theme_override_font_sizes/font_size = 16
text = "THE 30-SECOND TIME LOOP HAS COLLAPSED"
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="Panel/VBox"]
layout_mode = 2

[node name="LoreText" type="RichTextLabel" parent="Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "[center]Through harmonic synchronization with your past echoes, the resonance core stabilized.

The fractured tachyon manifold sealed itself. Linear time resumes across the facility.

Dr. Aris Thorne's emergency protocols functioned precisely as theorized. You have survived the chronal anomaly and breached the containment perimeter.[/center]"

[node name="ReplayButton" type="Button" parent="Panel/VBox"]
custom_minimum_size = Vector2(200, 40)
layout_mode = 2
size_flags_horizontal = 4
text = "REPEAT EXPERIMENT"

[node name="MenuButton" type="Button" parent="Panel/VBox"]
custom_minimum_size = Vector2(200, 36)
layout_mode = 2
size_flags_horizontal = 4
text = "RETURN TO MAIN MENU"
