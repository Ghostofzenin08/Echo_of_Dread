[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_hud.gd" id="1_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="2_pause"]
[ext_resource type="Script" path="res://scripts/ui/timeline_widget.gd" id="3_timeline"]

[node name="GameHUD" type="CanvasLayer"]
layer = 20
script = ExtResource("1_hud")

[node name="TopBar" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 64.0
grow_horizontal = 2

[node name="Margin" type="MarginContainer" parent="TopBar"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 8

[node name="HBox" type="HBoxContainer" parent="TopBar/Margin"]
layout_mode = 2
theme_override_constants/separation = 30

[node name="ChamberLabel" type="Label" parent="TopBar/Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.8, 0.9, 1, 1)
theme_override_font_sizes/font_size = 18
text = "CHAMBER 01: TEMPORAL RESONANCE"
vertical_alignment = 1

[node name="TimerContainer" type="VBoxContainer" parent="TopBar/Margin/HBox"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
alignment = 1

[node name="TimerLabel" type="Label" parent="TopBar/Margin/HBox/TimerContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.9, 1, 1)
theme_override_font_sizes/font_size = 20
text = "30.0s"
horizontal_alignment = 1

[node name="TimelineWidget" type="Control" parent="TopBar/Margin/HBox/TimerContainer"]
custom_minimum_size = Vector2(280, 18)
layout_mode = 2
script = ExtResource("3_timeline")

[node name="TimerBar" type="ProgressBar" parent="TopBar/Margin/HBox/TimerContainer"]
visible = false
custom_minimum_size = Vector2(0, 4)
layout_mode = 2
max_value = 30.0
value = 30.0
show_percentage = false

[node name="LoopLabel" type="Label" parent="TopBar/Margin/HBox"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)
theme_override_font_sizes/font_size = 16
text = "LOOP #01"
horizontal_alignment = 1
vertical_alignment = 1

[node name="EchoLabel" type="Label" parent="TopBar/Margin/HBox"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 1, 0.6, 1)
theme_override_font_sizes/font_size = 16
text = "ECHOES: 0 / 5"
horizontal_alignment = 1
vertical_alignment = 1

[node name="BottomBar" type="PanelContainer" parent="."]
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -36.0
grow_horizontal = 2
grow_vertical = 0

[node name="Margin" type="MarginContainer" parent="BottomBar"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_right = 16

[node name="ControlsLabel" type="Label" parent="BottomBar/Margin"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.85, 0.9)
theme_override_font_sizes/font_size = 13
text = "[WASD / Arrows] Move   |   [E / Space] Interact   |   [R] Rewind Loop   |   [C] Clear Echoes & Reset   |   [ESC] Pause"
horizontal_alignment = 1
vertical_alignment = 1

[node name="RewindFlash" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.2, 0.8, 1, 0)

[node name="TerminalModal" type="PanelContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -200.0
offset_right = 320.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="TerminalModal"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="TerminalModal/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="TerminalModal/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 1, 0.5, 1)
theme_override_font_sizes/font_size = 18
text = "TERMINAL LOG TITLE"

[node name="MetaLabel" type="Label" parent="TerminalModal/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.8, 0.6, 0.8)
theme_override_font_sizes/font_size = 12
text = "AUTHOR | TIMESTAMP"

[node name="HSeparator" type="HSeparator" parent="TerminalModal/Margin/VBox"]
layout_mode = 2

[node name="ContentLabel" type="RichTextLabel" parent="TerminalModal/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.9, 0.95, 0.9, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "Log content appears here..."

[node name="CloseButton" type="Button" parent="TerminalModal/Margin/VBox"]
custom_minimum_size = Vector2(120, 32)
layout_mode = 2
size_flags_horizontal = 4
text = "DISMISS [ESC]"

[node name="PauseMenu" parent="." instance=ExtResource("2_pause")]
visible = false
